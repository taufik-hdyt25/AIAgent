!projects/PROJECTS_SUMMARY.md
!projects/intiva/
!projects/intiva/.gitkeep
!projects/intiva/README.md
!projects/intiva/PROJECT_INFO.md

# OS & Docker overrides
.DS_Store
docker-compose.override.yml
telegram-ai-agent/docker-compose.override.yml

