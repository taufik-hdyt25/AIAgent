node_modules/
telegram-ai-agent/node_modules/

# Environment files
.env
telegram-ai-agent/.env

# Logs
logs/
telegram-ai-agent/logs/

# Runtime data & auth
data/*
!data/projects.json
!data/.gitkeep
claude_auth/
gemini_auth/
telegram-ai-agent/claude_auth/
telegram-ai-agent/gemini_auth/
