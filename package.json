{
  "name": "telegram-coding-agent",
  "version": "1.0.0",
  "description": "Telegram AI Coding Agent powered by Antigravity CLI, Claude Code CLI, and grammY",
  "private": true,
  "type": "module",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "background": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop telegram-coding-agent",
    "restart": "pm2 restart telegram-coding-agent",
    "logs": "pm2 logs telegram-coding-agent",
    "ui": "node src/web-server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0"
  }
}
