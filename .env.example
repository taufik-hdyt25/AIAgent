# Telegram Bot Token dari @BotFather
BOT_TOKEN=8913273189:AAEWJuFnsmjsAvv5SJo7K5GFq2MKcVmugis

# ID Telegram user yang diizinkan (pisahkan dengan koma jika lebih dari satu)
ALLOWED_TELEGRAM_IDS=7582829091

# Path konfigurasi projects
PROJECTS_FILE=./data/projects.json

# Lokasi binary agy (Antigravity CLI)
# Default macOS: /Users/<user>/.local/bin/agy
# Default Linux/VPS: /home/coder/.local/bin/agy atau /usr/local/bin/agy
AGY_BIN=/Users/intiva/.local/bin/agy

# Timeout per task coding dalam milidetik (default 15 menit)
TASK_TIMEOUT_MS=900000

# Maksimal panjang karakter output yang dicatat dan diproses
MAX_TASK_OUTPUT=12000

# Flag permissions untuk agy:
# Jika false/tidak diset, CLI memerlukan rules allow di ~/.gemini/antigravity-cli/settings.json
# Jika true, menambahkan --dangerously-skip-permissions pada agy non-interaktif
AGY_AUTO_APPROVE_PERMISSIONS=false
