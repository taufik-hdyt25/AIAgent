# Telegram Bot Token dari @BotFather (dapatkan dari https://t.me/BotFather)
BOT_TOKEN=

# ID Telegram user yang diizinkan (pisahkan dengan koma jika lebih dari satu, dapatkan via @userinfobot)
ALLOWED_TELEGRAM_IDS=

# Path konfigurasi projects
PROJECTS_FILE=./data/projects.json

# Lokasi binary agy (Antigravity CLI)
# Default macOS: /Users/<user>/.local/bin/agy
# Default Linux/VPS: /home/coder/.local/bin/agy atau /usr/local/bin/agy
AGY_BIN=/Users/intiva/.local/bin/agy

# Timeout per task coding dalam milidetik (default 15 menit)
TASK_TIMEOUT_MS=900000

# Maksimal panjang karakter output yang dicatat dan diproses
MAX_TASK_OUTPUT=12000

# Flag permissions untuk agy:
# Jika false/tidak diset, CLI memerlukan rules allow di ~/.gemini/antigravity-cli/settings.json
# Jika true, menambahkan --dangerously-skip-permissions pada agy non-interaktif
AGY_AUTO_APPROVE_PERMISSIONS=false

# Engine CLI yang digunakan: 'agy' (Antigravity) atau 'claude' (Claude Code)
CLI_ENGINE=agy

# Lokasi binary Claude Code CLI
# Default macOS: /Users/<user>/.local/bin/claude atau /usr/local/bin/claude
CLAUDE_BIN=/Users/intiva/.local/bin/claude

# Default model AI untuk agy (bisa diubah via /model: gemini-3.8-flash-medium, claude-sonnet-4-6, claude-opus-4-6-thinking)
AGY_MODEL=gemini-3.8-flash-medium

# Model untuk Claude Code CLI (default: sonnet)
CLAUDE_MODEL=sonnet

# Port Web UI Settings (default: 3030)
WEB_PORT=3030

# Metode autentikasi Claude Code: 'oauth' (sesi login) atau 'api_key'
CLAUDE_AUTH_TYPE=oauth
ANTHROPIC_API_KEY=

# Metode autentikasi Antigravity: 'oauth' (sesi login Google) atau 'api_key'
AGY_AUTH_TYPE=oauth
GEMINI_API_KEY=

# Konfigurasi Universal API (Zero-CLI: DeepSeek / OpenRouter / OpenAI-compatible)
UNIVERSAL_BASE_URL=https://api.deepseek.com/v1
UNIVERSAL_API_KEY=
UNIVERSAL_MODEL=deepseek-chat

# Konfigurasi GitHub Watcher, Auto-Fix, & Pull Request Automation
GITHUB_TOKEN=
GITHUB_WATCHER_ENABLED=true
GITHUB_POLL_INTERVAL_MINUTES=5
GITHUB_AUTO_ANALYZE=true
GITHUB_AUTO_FIX=false

# Perintah Shell untuk Deployment ke Server (dieksekusi via /deploy di Telegram)
# Contoh VPS/Docker: "docker compose pull && docker compose up -d"
# Contoh Node.js/PM2: "git pull origin main && npm install && pm2 reload all"
DEPLOY_COMMAND=git pull && npm install && pm2 reload all || pm2 reload ecosystem.config.cjs



